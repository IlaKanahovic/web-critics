model User {
    id                   String   @id @default(cuid())
    username             String
    phone                String
    email                String
    budgetFrom           String   @map("budget_from")
    budgetTo             String   @map("budget_to")
    descriprion          String?
    services             String?
    advertisement        Boolean
    quantityApplications String   @map("quantity_applications")
    createdAt            DateTime @default(now()) @map("created_at")

    @@map("users")
}
