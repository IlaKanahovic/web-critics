model Article {
  id          String   @id @default(cuid())
  type        String
  slug        String
  title       String
  description String
  previewBg   String   @map("preview_bg")
  avatar      String
  nameAuthor  String   @map("name_author")
  date        DateTime
  readingTime String   @map("reading_time")
  content     String

  @@map("articles")
}

model Case {
  id             String   @id @default(cuid())
  title          String
  service        String
  type           String
  previewBg      String   @map("preview_bg")
  previewProject String[] @map("preview_project")
  slug           String
  url            String?
  tasks          String[]
  popups         String[]
  interesting    String[]

  @@map("cases")
}

model Product {
  id                      String   @id @default(cuid())
  title                   String   @unique
  type                    String
  businessType            String   @map("business_type")
  description             String
  features                String[]
  singlePrice             String   @map("single_price")
  mounthPrice             String   @map("mounth_price")
  previewBg               String   @map("preview_bg")
  slug                    String
  demoUrl                 String   @map("demp_url")
  categoryDesc            String   @map("category_desc")
  estimation              String
  positive                String[]
  included                String[]
  possibleSettings        String[] @map("possible_settings")
  additionally            String[]
  desciptionPurpose       String   @map("description_purpose")
  suitable                String[]
  notSuitable             String[] @map("not_suitable")
  howItWorks              String   @map("how_it_works")
  specifications          String[]
  requirements            String
  valuesRequirements      String[] @map("values_requirements")
  launchFromMounth        String   @map("launch_from_mounth")
  launchFromSingle        String   @map("launch_from_single")
  onetimePurchaseIncludes String[] @map("onetime_purchase_includes")
  subscriptionIncludes    String[] @map("subscription_includes")

  @@map("products")
}

model Review {
  id          String   @id @default(cuid())
  name        String
  nameCompany String?  @map("name_company")
  avatar      String?
  date        DateTime
  estimation  String
  category    String
  description String
  caseHref    String?

  @@map("reviews")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  phone                  String             @unique
  email                  String             @unique
  createdAt              DateTime           @default(now()) @map("created_at")
  consentedAt            DateTime?
  consentVersion         String?
  consentIp              String?
  advertisingConsent     Boolean            @default(false)
  advertisingConsentedAt DateTime?
  leads                  Lead[]
  catalogPurchases       CatalogPurchases[]

  @@map("users")
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  budgetFrom  Int        @map("budget_from")
  budgetTo    Int        @map("budget_to")
  description String?
  services    String[]
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  ownerId     String     @map("owner_id")
  owner       User       @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("leads")
}

enum PurchaseFormat {
  ONE_TIME
  SUBSCRIPTION
}

model CatalogPurchases {
  id              String         @id @default(cuid())
  format          PurchaseFormat
  description     String?
  nameProduct     String         @map("name_product")
  price           Int
  offerAcceptedAt DateTime       @map("offer_accepted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  ownerId         String         @map("owner_id")
  owner           User           @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("catalog_purchases")
}
